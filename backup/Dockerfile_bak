# --- 阶段 1: 锻造 (编译依赖) ---
FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements.txt .

# 安装依赖到指定前缀目录
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# --- 阶段 2: 运行 (绝对隔离) ---
FROM gcr.io/distroless/python3-debian12
WORKDIR /app

# 拷贝依赖
COPY --from=builder --chown=1000:1000 /install /usr/local
# ✅ 修正：因为构建上下文是 ./backend，所以直接用 . 代表当前目录
COPY --chown=1000:1000 . /app/backend 

ENV PYTHONUNBUFFERED=1

ENV HOME=/app 

# ✅ 修正：入口统一为 backend.main:app
CMD ["/usr/bin/python3", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
