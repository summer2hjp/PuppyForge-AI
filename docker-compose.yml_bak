services:
  forge-api:  # Backend - FastAPI叛逆核心
    build: ./backend
    ports:
      - "8000:8000"
    user: "${UID:-1000}:${GID:-1000}" 
    environment:
      #- REDIS_URL=redis://redis:6379
      - REDIS_URL=redis://:123456@redis:6379
      - QDRANT_URL=http://qdrant:6333
      #- SUPABASE_URL=http://supabase:5432  # 新增
      - SUPABASE=postgresql://root:123456@postgres:5432/postgres-db
      - GROK_API_KEY=${GROK_API_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - FRONTEND_URL=http://frontend:3000
    depends_on:
      - redis
      - qdrant
      #- supabase
      - postgres
    #deploy:
    # resources:
    #    reservations:
    #     devices:
    #        - driver: nvidia
    #          count: all
    #          capabilities: [gpu]
    volumes:
      - ./backend:/app:delegated
    command: uvicorn gateway.main:app --host 0.0.0.0 --port 8000 --reload

  frontend:  # Next.js 15 前线视觉战场
    build: ./frontend
    target: runner 
    args:
      # ✅ 从 .env 文件读取变量，并在构建时注入给 Dockerfile 的 ARG
      NEXT_PUBLIC_BACKEND_URL: ${BACKEND_URL}
      NEXT_PUBLIC_WS_URL: ${WS_URL}
    ports:
      - "3000:3000"
    #environment:
    #  - BACKEND_URL=http://forge-api:8000
    #  - WS_URL=ws://forge-api:8000
    depends_on:
      - forge-api
    volumes:
      - ./frontend:/app
      - /app/node_modules
    command: npm run dev

  #redis:
  #  image: redis/redis-stack:latest
  #  ports:
  #    - "6379:6379"
  #  volumes:
  #    - redis_data:/data

  qdrant:
    image: qdrant/qdrant:latest
    ports:
      - "6333:6333"
    volumes:
      - qdrant_storage:/qdrant/storage

  #supabase:  # 本地Supabase/Postgres（你仓库里有supabase文件夹）
  #  image: supabase/postgres:latest
  #  ports:
  #    - "5432:5432"
  #  environment:
  #    - POSTGRES_PASSWORD=postgres
  #    - POSTGRES_USER=postgres
  #  volumes:
  #    - supabase_data:/var/lib/postgresql/data
  #   - ./supabase/migrations:/docker-entrypoint-initdb.d

  redis:
    image: redis:latest
    container_name: redis
    restart: always
    command: ["redis-server", "--requirepass", "123456"]
    volumes:
      - redis_data:/data

  postgres:
    image: postgres:15
    container_name: postgres
    restart: always
    environment:
      POSTGRES_USER: root
      POSTGRES_PASSWORD: 123456
      POSTGRES_DB: postgres-db
    volumes:
      - pg_data:/var/lib/postgresql/data

volumes:
  qdrant_storage:
  redis_data:
  #supabase_data:
  pg_data:
