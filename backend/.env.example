GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

LLM_MODEL=gpt-4o-mini

# ==================== 应用配置 ====================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-in-prod-xyz123!@#
API_V1_STR=/api/v1

# ==================== 数据库（异步） ====================
DATABASE_URL=sqlite+aiosqlite:///./puppyforge.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/puppyforge

# PostgreSQL: postgresql+asyncpg://user:pass@host:port/db（同步）
#DATABASE_URL=postgresql+asyncpg://puppy:forge@localhost:5432/puppyforge_dev

# Redis (用于缓存/队列)
REDIS_URL=redis://localhost:6379/0

# ==================== AI/LLM 配置 ====================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxx-placeholder
ANTHROPIC_API_KEY=sk-ant-xxx-placeholder

# ==================== 外部服务 ====================
# 向量数据库 (可选)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 对象存储 (可选)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=puppyforge-assets

# ==================== 观测性 ====================
LOG_LEVEL=INFO
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==================== 功能开关 ====================
ENABLE_REBEL_MODE=True
ENABLE_MEMORY_PERSISTENCE=True
MAX_MEMORY_WINDOW=100
