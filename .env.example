# --- 数据库与中间件 ---
POSTGRES_USER=root
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=postgres-db
REDIS_PASSWORD=your_redis_password

# --- 后端服务连接 URL (内部 Docker 网络) ---
# 注意：这里使用容器名作为 host，Docker DNS 会自动解析
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
QDRANT_URL=http://qdrant:6333
SUPABASE=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- 外部 API Keys ---
GROK_API_KEY=your_grok_key
OPENAI_API_KEY=your_openai_key

# --- 前端需要的 URL (会被注入到 Next.js 构建中) ---
# 如果是本地开发，这里写 localhost；如果是生产部署，这里写你的真实域名
BACKEND_URL=http://localhost:8000
WS_URL=ws://localhost:8000
FRONTEND_URL=http://localhost:3000
