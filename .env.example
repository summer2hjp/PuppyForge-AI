# ==========================================
# 🐕‍🦺 PuppyForge AI - 根目录环境变量示例
# ==========================================
# 📌 使用说明:
# 1. 复制本文件: cp .env.example .env
# 2. 替换所有占位符为实际值（切勿提交 .env 到 Git！）
# 3. Docker Compose 会自动读取本文件注入服务
# ==========================================

# ==================== 🐳 Docker & 基础设施 ====================
COMPOSE_PROJECT_NAME=puppyforge-ai
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=summer2hjp

# 服务端口映射
BACKEND_PORT=8000
FRONTEND_PORT=3000
PG_PORT=5432
REDIS_PORT=6379
TRAEFIK_DASHBOARD_PORT=8080

# ==================== 🗄️ 数据库 (PostgreSQL) ====================
POSTGRES_USER=puppy_admin
POSTGRES_PASSWORD=change_me_secure_pg_password_!@#
POSTGRES_DB=puppyforge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 连接池与性能
PG_MAX_CONNECTIONS=20
PG_POOL_TIMEOUT=30
PG_SSL_MODE=prefer  # require | prefer | disable

# ==================== ⚡ 缓存 & 队列 (Redis) ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_secure_redis_password_!@#
REDIS_DB=0
REDIS_URL=redis://:change_me_secure_redis_password_!@#@redis:6379/0

# ==================== 🔙 后端服务 (FastAPI/Python) ====================
ENVIRONMENT=development  # development | staging | production
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-prod-7f8a9b0c1d2e3f4g5h6i7j8k9l0m1n2o
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,https://app.puppyforge.ai
CORS_MAX_AGE=600

# JWT 认证
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 🎨 前端服务 (Next.js) ====================
# ⚠️ NEXT_PUBLIC_ 开头的变量会暴露到浏览器客户端
NEXT_PUBLIC_APP_NAME=PuppyForge AI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# 前端 SSR/Server Actions 专用（不暴露给浏览器）
BACKEND_SERVICE_SECRET=your-super-secret-key-change-in-prod-7f8a9b0c1d2e3f4g5h6i7j8k9l0m1n2o

# ==================== 🤖 AI / LLM 配置 ====================
LLM_PROVIDER=openai  # openai | anthropic | local | azure
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_STREAM_TIMEOUT=30

# API Keys (按需启用对应提供商)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434  # 本地部署时取消注释

# ==================== 🧩 向量存储 & 对象存储 (可选) ====================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=change_me_qdrant_api_key
QDRANT_COLLECTION=puppy_memories

S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET=puppyforge-assets
S3_REGION=us-east-1

# ==================== 📊 观测性 & 日志 ====================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=https://xxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=9090

# ==================== 🚀 功能开关 & 业务调优 ====================
ENABLE_REBEL_MODE=true
ENABLE_MEMORY_PERSISTENCE=true
ENABLE_SWARM_ORCHESTRATION=true
ENABLE_HEALTH_CHECK_ENDPOINTS=true

# 行为参数
MAX_MEMORY_WINDOW=100
REBEL_THRESHOLD=0.65
PERSONA_DRIFT_RATE=0.02
CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS_PER_MINUTE=60
WEBHOOK_RETRY_MAX=3
WORKER_CONCURRENCY=4
